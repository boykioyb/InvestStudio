# Sao chép thành .env rồi điền giá trị:  cp .env.example .env
# docker-compose đọc các biến này; .env đã nằm trong .gitignore.

# ── RAG / Gemini ──────────────────────────────────────────────────────────────
# Bắt buộc để dùng trợ lý hỏi–đáp. Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini sinh câu trả lời.
LLM_MODEL=gemini-3.6-flash
# Model nhúng (embedding). Phải là model hỗ trợ embedContent trên key của bạn.
EMBED_MODEL=gemini-embedding-001

# ── Bảo mật ───────────────────────────────────────────────────────────────────
# Bí mật ký token đăng nhập (JWT). ĐỔI trước khi lên môi trường thật.
APP_JWT_SECRET=doi-bi-mat-nay-truoc-khi-len-that
# "dev" | "prod". Ở prod: tắt /docs, /openapi.json, bật HSTS.
# APP_ENV=dev

# ── Hạn mức (chống một người đốt sạch quota của cả hệ thống) ───────────────────
# Số lượt hỏi trợ lý / người / ngày. Mặc định 5 vì Gemini đang chạy bản MIỄN PHÍ.
# APP_RAG_DAILY_QUOTA=5
# Trần SỐ REQUEST Gemini/ngày cho toàn hệ thống. Đọc quota thật của dự án trong
# AI Studio rồi chừa ~100 cho job nền (reindex 8h sáng).
# APP_GEMINI_DAILY_CALL_CAP=1400
# Số câu hỏi được gọi Gemini cùng lúc (bản miễn phí ~10-15 request/phút).
# APP_GEMINI_MAX_CONCURRENT=2
# Lượt phân tích/ngày: khách (theo IP) và thành viên (theo tài khoản).
# APP_GUEST_ANALYZE_DAILY=30
# APP_MEMBER_ANALYZE_DAILY=100
# Trần request/phút cho mỗi IP trên toàn bộ /api.
# APP_API_RATE_LIMIT_PER_MINUTE=120
# Dải IP được tin khi đọc X-Forwarded-For / X-Real-IP (proxy của mình).
# Docker compose đã đặt sẵn ["172.16.0.0/12"]; đổi khi có reverse proxy thật.
# APP_TRUSTED_PROXIES=["172.16.0.0/12"]

# ── Khu quản trị (admin.<domain>) ─────────────────────────────────────────────
# Danh sách IP/dải CIDR được vào /api/admin. RỖNG = không giới hạn (chỉ hợp dev).
# APP_ADMIN_IP_ALLOWLIST=["113.161.0.0/16"]
# Bắt buộc xác thực 2 lớp (TOTP) cho tài khoản quản trị. Mặc định BẬT.
# APP_ADMIN_REQUIRE_2FA=true
# Đặt khi khu quản trị ở tên miền con, để dùng chung phiên đăng nhập.
# APP_COOKIE_DOMAIN=.mien-cua-ban.vn

# ── Email giao dịch (xác minh tài khoản, quên mật khẩu) ───────────────────────
# Chưa cấu hình thì link chỉ in ra log máy chủ — BẮT BUỘC đặt trước khi mở cho người lạ.
# APP_SMTP_HOST=smtp.gmail.com
# APP_SMTP_PORT=587
# APP_SMTP_USER=
# APP_SMTP_PASSWORD=
# APP_SMTP_FROM=Phân Tích Mã <no-reply@mien-cua-ban.vn>
# APP_PUBLIC_BASE_URL=https://mien-cua-ban.vn

# ── Cổng (tùy chọn) ─────────────────────────────────────────────────────────────
# WEB_PORT=3010
# API_PORT=8010
# ADMIN_PORT=3020
