# Sao chép thành .env.prod rồi điền. KHÔNG commit tệp .env.prod.
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── Bắt buộc ──────────────────────────────────────────────────────────────────
# Tên miền chính. DNS phải trỏ CẢ <domain> lẫn admin.<domain> về máy chủ này.
DOMAIN=phantichma.vn
# Mật khẩu Postgres — sinh ngẫu nhiên:  openssl rand -base64 24
POSTGRES_PASSWORD=
# Bí mật ký token đăng nhập ≥32 ký tự:  openssl rand -hex 32
# (app TỪ CHỐI khởi động nếu để mặc định khi đã bật HTTPS)
APP_JWT_SECRET=

# ── Khu quản trị ──────────────────────────────────────────────────────────────
# Dải IP được vào /api/admin. Rỗng = không giới hạn — ĐỪNG để rỗng ở môi trường thật.
ADMIN_IP_ALLOWLIST=["113.161.0.0/16"]

# ── Trợ lý (Gemini) ───────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Email giao dịch — BẮT BUỘC, thiếu thì người dùng mới không xác minh được ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Phân Tích Mã <no-reply@phantichma.vn>

# ── Sao lưu ───────────────────────────────────────────────────────────────────
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14
